{
  "name": "pbs-loader-docs",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "reference": "node scripts/reference/generate.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"scripts/**/*.mjs\" --test-coverage-exclude=\"scripts/**/*.test.mjs\" --test-coverage-exclude=\"scripts/**/fixtures.mjs\" \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.0",
    "sharp": "0.35.5",
    "starlight-llms-txt": "0.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
